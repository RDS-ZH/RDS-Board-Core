{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "paths": {
      "@rds/kernel/*": ["./packages/kernel/src/*"],
      "@rds/games/*": ["./packages/games/src/*"],
      "@rds/app/*": ["./packages/app/src/*"],
      "@rds/net/*": ["./packages/net/src/*"],
      "@rds/web/*": ["./apps/web/src/*"],
      "@rds/room-protocol": ["./packages/room-protocol/src/index.ts"]
    }
  },
  "include": ["apps/web/src", "apps/server/src", "packages/*/src"]
}
